# Database (defaults to SQLite at ./mindyy.db)
DATABASE_URL=sqlite:///./mindyy.db

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# Redis (required for OTP storage)
REDIS_URL=redis://localhost:6379/0

# SMTP (Mailtrap.io recommended for dev; Gmail w/ app password for prod test)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mindyy.local
SMTP_USE_TLS=true

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where to send the user after successful Google login (frontend route)
FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback
